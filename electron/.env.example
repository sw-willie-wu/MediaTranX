# MediaTranX Electron Dev 環境設定
# 複製此檔為 .env 並依需求修改（.env 已被 gitignore）
# 變數名稱對應 pydantic-settings nested delimiter: MEDIATRANX_PATH__*

# 資料根目錄（Dev 預設指向 backend，跟 uv run 手動開發共用）
# bin/.venv/logs 一律從 ROOT 衍生，無法獨立 override
MEDIATRANX_PATH__ROOT=../backend

# AI 模型與暫存目錄（可選 override，可放到大硬碟）
# MEDIATRANX_PATH__MODELS=D:/ai-models
# MEDIATRANX_PATH__TEMP=D:/mediatranx-temp

# 資料庫（預設 sqlite:///mediatranx.db，相對於 ROOT）
# MEDIATRANX_DB__DSN=sqlite:///mediatranx.db
