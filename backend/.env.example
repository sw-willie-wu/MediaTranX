# MediaTranX Backend 環境設定
# 複製此檔為 .env 並依需求修改（.env 已被 gitignore）
# Electron 啟動時會透過 env var 覆蓋（MEDIATRANX_PATH__* 格式）

# 使用者資料根目錄（預設：cwd，dev 下 = core/backend/）
# 包含 DB / .env / logs / .venv / bin（後三者從 ROOT 衍生，無法獨立 override）
# MEDIATRANX_PATH__ROOT=.

# AI 模型目錄（預設：{cwd}/models，可放到大硬碟）
# MEDIATRANX_PATH__MODELS=D:/ai-models

# 暫存目錄（uploads/results/sidecars，預設：{cwd}/temp）
# MEDIATRANX_PATH__TEMP=D:/mediatranx-temp

# 資料庫 DSN（預設 sqlite:///mediatranx.db，相對於 ROOT）
# MEDIATRANX_DB__DSN=sqlite:///mediatranx.db
