# MediaTranX Configuration
# All values are optional — defaults are auto-detected.
# Use nested delimiter __ for grouped settings.

# ── Server ──
# MEDIATRANX_SERVER__MODE=dev           # dev | production
# MEDIATRANX_SERVER__HOST=0.0.0.0
# MEDIATRANX_SERVER__PORT=8001
# MEDIATRANX_SERVER__LOG_LEVEL=debug    # debug | info | warning | error

# ── Paths ──
# MEDIATRANX_PATH__DATA=/custom/data
# MEDIATRANX_PATH__MODELS=/custom/models
# MEDIATRANX_PATH__TEMP=/custom/temp
# MEDIATRANX_PATH__FFMPEG=/usr/bin
# MEDIATRANX_PATH__FLUIDSYNTH=/usr/bin
# MEDIATRANX_PATH__LLAMA_BIN=/custom/llama

# ── Database ──
# MEDIATRANX_DB__DSN=sqlite:///custom.db

# ── Platform (usually auto-detected) ──
# MEDIATRANX_IS_FROZEN=false
# MEDIATRANX_PLATFORM=linux
