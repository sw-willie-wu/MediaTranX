# Python venv
.venv/
Include/
Lib/
Scripts/
share/
pyvenv.cfg
__pycache__/
*.pyc

# Allow our committed dev scripts (Scripts/ above is the venv binary dir
# on Windows; on case-insensitive filesystems it also catches our
# real scripts/ dirs. Add explicit un-ignores.)
!backend/scripts/
!backend/scripts/**
!/scripts/
!/scripts/**
!electron/scripts/
!electron/scripts/**

# Re-exclude bytecode that the scripts/ un-ignores above would re-include
__pycache__/
*.pyc

# Node
node_modules/
dist/
build/

# IDE
.vscode/
.idea/

# Temp & Dev
temp/
data/
output/
*.log
*.db
*.db-shm
*.db-wal
/test_*.py
/test_*.txt

# Test artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Build artifacts
src/backend/static/
ncnn-models/
backend/ncnn-models/

# Binaries
backend/bin/
/models/
backend/models/

# Env (保留 .env.production)
.env
.env.local
.env.*.local

# Agents
.claude/
CLAUDE.md
.gemini/
